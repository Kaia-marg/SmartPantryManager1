<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_cream"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Pantry Manager"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/primary_warm_brown"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Track your inventory &amp; discover recipes"
        android:textSize="14sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="40dp"/>

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnViewPantry"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="View Pantry Inventory"
        android:textSize="16sp"
        android:textColor="@color/surface_card"
        android:backgroundTint="@color/primary_warm_brown"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnAddItem"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Add Pantry Item"
        android:textSize="16sp"
        android:textColor="@color/surface_card"
        android:backgroundTint="@color/primary_variant_terracotta"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnViewRecipes"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Browse Recipes (15 Seeded)"
        android:textSize="16sp"
        android:textColor="@color/surface_card"
        android:backgroundTint="@color/accent_sage_green"/>

</LinearLayout>