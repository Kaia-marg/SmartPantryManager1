<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_cream"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Suggested Recipes You Can Make"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/primary_warm_brown"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Based on your current pantry inventory"
        android:textSize="14sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="16dp"/>

    <ListView
        android:id="@+id/listViewSuggestedRecipes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/text_muted"
        android:dividerHeight="1dp"/>

</LinearLayout>